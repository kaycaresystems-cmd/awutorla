# Supabase Configuration Template
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Hubtel SMS credentials are NOT read from this file — the app no longer calls Hubtel
# from the browser (no payment gateway). SMS for walk-in client access codes is sent
# server-side by the create-walkin-client Edge Function; set its secrets with:
#   supabase secrets set HUBTEL_CLIENT_ID=... HUBTEL_CLIENT_SECRET=... HUBTEL_SENDER_ID=...
